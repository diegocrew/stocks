<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/stock_widget_background"
    android:orientation="vertical"
    android:padding="16dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:gravity="center_vertical" android:orientation="horizontal">
        <TextView android:id="@+id/widget_title" android:layout_width="0dp"
            android:layout_height="wrap_content" android:layout_weight="1"
            android:text="Stock Atlas" android:textColor="#ffffff" android:textStyle="bold"
            android:maxLines="1" android:ellipsize="end" android:textSize="15sp" />
        <TextView android:id="@+id/widget_settings" android:layout_width="48dp"
            android:layout_height="48dp" android:gravity="center" android:text="&#9881;"
            android:contentDescription="Configure widget" android:textColor="#ffffff" android:textSize="22sp" />
    </LinearLayout>
    <TextView android:id="@+id/widget_move" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:text="Updating…" android:textColor="#ffffff"
        android:textStyle="bold" android:textSize="24sp" />
    <TextView android:id="@+id/widget_status" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:text="Daily move"
        android:textColor="#ffffff" android:textSize="11sp" android:maxLines="2" />
</LinearLayout>
