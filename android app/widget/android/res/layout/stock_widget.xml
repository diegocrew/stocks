<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/stock_widget_background"
    android:orientation="vertical"
    android:padding="8dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="32dp"
        android:gravity="center_vertical" android:orientation="horizontal">
        <TextView android:id="@+id/widget_title" android:layout_width="0dp"
            android:layout_height="wrap_content" android:layout_weight="1"
            android:text="Stock Atlas · Daily move" android:textColor="#ffffff" android:textStyle="bold"
            android:maxLines="1" android:ellipsize="end" android:textSize="13sp" />
        <TextView android:id="@+id/widget_settings" android:layout_width="40dp"
            android:layout_height="match_parent" android:gravity="center" android:text="&#9881;"
            android:contentDescription="Configure widget" android:textColor="#ffffff" android:textSize="22sp" />
    </LinearLayout>
    <LinearLayout android:id="@+id/widget_rows" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:orientation="vertical" />
    <TextView android:id="@+id/widget_status" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:text="Waiting for data"
        android:textColor="#ffffff" android:textSize="10sp" android:maxLines="2" />
</LinearLayout>
